#!/bin/bash
#
# stay-active - Keep Microsoft Teams (and other apps) showing you as "Active"
# Author: Sleekhost
# License: MIT
# Repository: https://github.com/sleekhost/stay-active
#

VERSION="1.0.0"
PLATFORM=$(uname -s)

CONTROL_FILE="$HOME/.local/.stay_active_on"
PID_FILE="$HOME/.local/.stay_active_pid"
LOG_FILE="$HOME/.local/.stay_active_log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_help() {
    cat << EOF
stay-active v${VERSION}
Keep Microsoft Teams (and other apps) showing you as "Active" on macOS and Linux

USAGE:
    stay-active <command>

COMMANDS:
    start       Start the activity daemon
    stop        Stop the activity daemon
    toggle      Toggle the daemon on/off
    status      Check if daemon is running
    log         View recent activity log

OPTIONS:
    -h, --help      Show this help message
    -v, --version   Show version number

EXAMPLES:
    stay-active start     # Start keeping you active
    stay-active stop      # Stop the daemon
    stay-active toggle    # Quick toggle on/off
    stay-active log       # See what it's been doing

HOW IT WORKS:
    Simulates natural mouse movement and keyboard activity at random
    intervals (30-60 seconds) to prevent apps from marking you as "Away".
    Uses human-like patterns to avoid detection.

REQUIREMENTS:
    - macOS 10.13+ with cliclick and Accessibility permissions
    - Linux X11 with xdotool
    - Linux Wayland with ydotool and ydotoold

AUTHOR:
    Sleekhost
    https://github.com/sleekhost/stay-active

EOF
}

show_version() {
    echo "stay-active v${VERSION}"
}

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

get_random_interval() {
    echo $((30 + RANDOM % 31))
}

get_random_offset() {
    echo $((RANDOM % 11 - 5))
}

is_wayland() {
    [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
}

get_mouse_position() {
    case "$PLATFORM" in
        Darwin)
            cliclick p 2>/dev/null | grep -oE '^[0-9]+,[0-9]+'
            ;;
        Linux)
            position=$(xdotool getmouselocation --shell 2>/dev/null) || return 1
            current_x=$(printf '%s\n' "$position" | sed -n 's/^X=\([0-9][0-9]*\)$/\1/p')
            current_y=$(printf '%s\n' "$position" | sed -n 's/^Y=\([0-9][0-9]*\)$/\1/p')

            if [ -n "$current_x" ] && [ -n "$current_y" ]; then
                printf '%s,%s\n' "$current_x" "$current_y"
            else
                return 1
            fi
            ;;
    esac
}

check_requirements() {
    case "$PLATFORM" in
        Darwin)
            if ! command -v cliclick > /dev/null 2>&1; then
                echo -e "${RED}Error: cliclick not found${NC}"
                echo ""
                echo "Install it with:"
                echo "  brew install cliclick"
                echo ""
                echo "Then grant Accessibility permissions in:"
                echo "  System Settings → Privacy & Security → Accessibility"
                return 1
            fi
            ;;
        Linux)
            if is_wayland; then
                if ! command -v ydotool > /dev/null 2>&1; then
                    echo -e "${RED}Error: ydotool not found${NC}"
                    echo "Install ydotool and configure ydotoold before starting stay-active."
                    return 1
                fi

                if ! ydotool mousemove -x 0 -y 0 > /dev/null 2>&1; then
                    echo -e "${RED}Error: Cannot access ydotoold${NC}"
                    echo "Confirm ydotoold is running and its socket permissions allow access."
                    return 1
                fi
                return 0
            fi

            if [ -z "${DISPLAY:-}" ]; then
                echo -e "${RED}Error: DISPLAY is not set${NC}"
                echo "Start stay-active from an X11 desktop session."
                return 1
            fi

            if ! command -v xdotool > /dev/null 2>&1; then
                echo -e "${RED}Error: xdotool not found${NC}"
                echo "Install it with your distribution package manager."
                return 1
            fi

            if ! get_mouse_position > /dev/null; then
                echo -e "${RED}Error: Cannot access the X11 display${NC}"
                echo "Confirm DISPLAY and X11 permissions, then try again."
                return 1
            fi
            ;;
        *)
            echo -e "${RED}Error: Unsupported platform: ${PLATFORM}${NC}"
            return 1
            ;;
    esac
}

move_mouse() {
    case "$PLATFORM" in
        Darwin)
            cliclick -e 30 m:"$1","$2" > /dev/null 2>&1
            ;;
        Linux)
            if is_wayland; then
                ydotool mousemove -x "$1" -y "$2" > /dev/null 2>&1
            else
                xdotool mousemove "$1" "$2" > /dev/null 2>&1
            fi
            ;;
    esac
}

press_shift() {
    case "$PLATFORM" in
        Darwin)
            cliclick kd:shift ku:shift > /dev/null 2>&1
            ;;
        Linux)
            if is_wayland; then
                ydotool key 42:1 42:0 > /dev/null 2>&1
            else
                xdotool key Shift_L > /dev/null 2>&1
            fi
            ;;
    esac
}

simulate_activity() {
    log_msg "Daemon started (v${VERSION})"

    while [ -f "$CONTROL_FILE" ]; do
        if [ "$PLATFORM" = "Linux" ] && is_wayland; then
            offset_x=$(get_random_offset)
            offset_y=$(get_random_offset)

            if move_mouse "$offset_x" "$offset_y"; then
                sleep "0.$((RANDOM % 3 + 1))"

                if press_shift; then
                    log_msg "Activity: mouse moved ($offset_x,$offset_y) + shift key"
                else
                    log_msg "Warning: Could not send shift key"
                fi

                if [ "${STAY_ACTIVE_TEST_RESTORE_MOUSE:-}" = "1" ] || [ $((RANDOM % 10)) -lt 6 ]; then
                    sleep "0.$((RANDOM % 5 + 1))"
                    if ! move_mouse "$((-offset_x))" "$((-offset_y))"; then
                        log_msg "Warning: Could not restore mouse position"
                    fi
                fi
            else
                log_msg "Warning: Could not move mouse"
            fi
        else
            current_pos=$(get_mouse_position)

            if [ -n "$current_pos" ]; then
                current_x=${current_pos%,*}
                current_y=${current_pos#*,}

                offset_x=$(get_random_offset)
                offset_y=$(get_random_offset)

                new_x=$((current_x + offset_x))
                new_y=$((current_y + offset_y))

                [ "$new_x" -lt 10 ] && new_x=10
                [ "$new_y" -lt 10 ] && new_y=10

                # Move mouse with easing on macOS and an immediate move on X11.
                if move_mouse "$new_x" "$new_y"; then
                    sleep "0.$((RANDOM % 3 + 1))"

                    # Press and release shift key (registers as activity)
                    if press_shift; then
                        log_msg "Activity: mouse ($current_x,$current_y)->($new_x,$new_y) + shift key"
                    else
                        log_msg "Warning: Could not send shift key"
                    fi

                    # 60% chance to move back (natural behavior)
                    if [ $((RANDOM % 10)) -lt 6 ]; then
                        sleep "0.$((RANDOM % 5 + 1))"
                        if ! move_mouse "$current_x" "$current_y"; then
                            log_msg "Warning: Could not restore mouse position"
                        fi
                    fi
                else
                    log_msg "Warning: Could not move mouse"
                fi
            else
                log_msg "Warning: Could not get mouse position"
            fi
        fi

        interval=$(get_random_interval)

        # 15% chance of shorter burst (more active period)
        if [ $((RANDOM % 100)) -lt 15 ]; then
            interval=$((15 + RANDOM % 15))
        fi

        log_msg "Sleeping ${interval}s"

        for ((i=0; i<interval; i++)); do
            [ ! -f "$CONTROL_FILE" ] && break
            sleep 1
        done
    done

    log_msg "Daemon stopped"
}

start_daemon() {
    if ! check_requirements; then
        return 1
    fi

    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo -e "${YELLOW}Already running${NC}"
        return 1
    fi

    # Ensure directory exists
    mkdir -p "$HOME/.local"

    # Keep last 100 log lines
    if [ -f "$LOG_FILE" ]; then
        tail -100 "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
    fi

    touch "$CONTROL_FILE"
    simulate_activity &
    echo $! > "$PID_FILE"
    echo -e "${GREEN}Started${NC} (PID: $(cat "$PID_FILE"))"
}

stop_daemon() {
    rm -f "$CONTROL_FILE"

    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            log_msg "Stopped by user"
            echo -e "${RED}Stopped${NC}"
        else
            echo -e "${YELLOW}Not running${NC}"
        fi
        rm -f "$PID_FILE"
    else
        echo -e "${YELLOW}Not running${NC}"
    fi
}

toggle_daemon() {
    if [ -f "$CONTROL_FILE" ]; then
        stop_daemon
    else
        start_daemon
    fi
}

status_daemon() {
    if [ -f "$CONTROL_FILE" ] && [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo -e "${GREEN}Running${NC} (PID: $(cat "$PID_FILE"))"
        return 0
    else
        echo -e "${RED}Stopped${NC}"
        return 1
    fi
}

show_log() {
    if [ -f "$LOG_FILE" ]; then
        echo -e "${YELLOW}Recent activity:${NC}"
        echo ""
        tail -20 "$LOG_FILE"
    else
        echo "No activity log yet. Start the daemon first."
    fi
}

# Parse arguments
case "${1:-}" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    toggle)
        toggle_daemon
        ;;
    status)
        status_daemon
        ;;
    log)
        show_log
        ;;
    -h|--help|help)
        show_help
        ;;
    -v|--version|version)
        show_version
        ;;
    "")
        echo "stay-active v${VERSION}"
        echo ""
        echo "Usage: stay-active <command>"
        echo ""
        echo "Commands: start, stop, toggle, status, log"
        echo ""
        echo "Run 'stay-active --help' for more information."
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'stay-active --help' for usage information."
        exit 1
        ;;
esac
